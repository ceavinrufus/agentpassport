    "directory": "packages/agentpassport-ts"
  },
  "homepage": "https://agentpassport.fyi",
  "bugs": {
    "url": "https://github.com/ceavinrufus/agentpassport/issues"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
