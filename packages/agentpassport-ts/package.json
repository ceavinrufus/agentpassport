{
  "name": "@agentpassport/core",
  "version": "0.3.4",
  "description": "TypeScript SDK for agentpassport \u2014 the AI passport layer",
  "license": "Apache-2.0",
  "keywords": [
    "ai",
    "agents",
    "authorization",
    "delegation",
    "did",
    "identity",
    "jwt",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
